      {
        "parameters": {
          "jsCode": "const email = $json.HelixEmail;\n\nconst match = email.match(/^([^+]+)\\+([^.@]+)\\.[^@]+(@.+)$/);\n\nreturn [\n  {\n    json: {\n      HelixSearchEmail: match\n        ? `${match[1]}+${match[2]}.*${match[3]}`\n        : email,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          944,
          -48
        ],
        "id": "c829de93-c2f5-42ac-a067-75bae654ffeb",
        "name": "WildCardEmail"
      },
      {
        "parameters": {
          "jsCode": "const originalEmail = $('Start').item.json.HelixEmail.toLowerCase();\nconst data = $json.Data || [];\n\nconst match = originalEmail.match(/^([^+]+\\+[^.]+\\.)[^@]+(@.+)$/);\n\nif (!match) {\n  return [{ json: { MatchStatus: 'doesnt_exist', MatchedHelixId: null } }];\n}\n\nconst routingPrefix = match[1];\nconst domain = match[2];\n\nfunction patientEmails(patient) {\n  return [patient.Email, patient.OtherEmail]\n    .filter(Boolean)\n    .map((email) => email.toLowerCase());\n}\n\nconst exactPatient = data.find((patient) =>\n  patientEmails(patient).some((email) => email === originalEmail)\n);\n\nif (exactPatient) {\n  return [{\n    json: {\n      MatchStatus: 'exists',\n      MatchedHelixId: exactPatient.Id || exactPatient.ID || exactPatient.id || null,\n    },\n  }];\n}\n\nconst highMatchPatient = data.find((patient) =>\n  patientEmails(patient).some((email) =>\n    email.startsWith(routingPrefix) && email.endsWith(domain)\n  )\n);\n\nif (highMatchPatient) {\n  return [{\n    json: {\n      MatchStatus: 'high_match',\n      MatchedHelixId: highMatchPatient.Id || highMatchPatient.ID || highMatchPatient.id || null,\n    },\n  }];\n}\n\nreturn [{ json: { MatchStatus: 'doesnt_exist', MatchedHelixId: null } }];"
        },
