    {
      "parameters": {
        "jsCode": "const email = $json.HelixEmail;\n\nconst match = email.match(/^([^+]+)\\+([^.@]+)\\.[^@]+(@.+)$/);\n\nreturn [\n  {\n    json: {\n      HelixSearchEmail: match\n        ? `${match[1]}+${match[2]}.*${match[3]}`\n        : email,\n    },\n  },\n];"
      },
