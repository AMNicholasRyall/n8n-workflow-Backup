      },
      {
        "parameters": {
          "jsCode": "const raw = String(\n  $input.first().json['Auth Bunble'] || ''\n).trim();\n\nif (!raw) {\n  throw new Error('Auth Bunble is empty.');\n}\n\nconst names = [\n  'authorization',\n  'cookie',\n  'x-xsrf-token',\n  'usercentreid',\n  'userworkareaid',\n  'x-helix-agent-id',\n  'x-helix-perform-as'\n];\n\nconst lines = raw\n  .split(/\\r?\\n/)\n  .map(line => line.trim())\n  .filter(Boolean);\n\nconst headers = {};\n\nfor (let i = 0; i < lines.length; i++) {\n  const name = lines[i].toLowerCase();\n\n  if (names.includes(name) && lines[i + 1]) {\n    headers[name] = lines[i + 1];\n    i++;\n  }\n}\n\nfunction getCookie(name) {\n  const prefix = name + '=';\n\n  const part = (headers.cookie || '')\n    .split(';')\n    .map(value => value.trim())\n    .find(value => value.startsWith(prefix));\n\n  return part ? part.slice(prefix.length) : null;\n}\n\nconst xsrfToken =\n  headers['x-xsrf-token'] ||\n  getCookie('XSRF-TOKEN');\n\nconst now = new Date().toISOString();\n\nreturn [\n  {\n    json: {\n      name: 'helix_live',\n      bearer_token: (headers.authorization || '')\n        .replace(/^Bearer\\s+/i, '')\n        .trim(),\n      cookie_bundle: headers.cookie || null,\n      csrf_token: xsrfToken,\n      status: 'ok',\n      last_checked_at: null,\n      last_success_at: null,\n      last_failure_at: null,\n      last_error: null,\n      xsrf_token: xsrfToken,\n      aspnet_cookie: getCookie('.AspNet.Cookies'),\n      userworkareaid: headers.userworkareaid || null,\n      usercentreid: headers.usercentreid || null,\n      x_helix_agent_id:\n        headers['x-helix-agent-id'] || null,\n      x_helix_perform_as:\n        headers['x-helix-perform-as'] || null,\n      id: 1,\n      createdAt: now,\n      updatedAt: now\n    }\n  }\n];"
        },
