      {
        "parameters": {
          "jsCode": "const personalInfo = $('GetGuestInfo').item.json.personal_info || {};\n\nconst rawGenderName = personalInfo.gender_name;\nconst rawGender = personalInfo.gender;\n\nconst genderName = String(rawGenderName ?? '').trim().toLowerCase();\nconst genderValue = String(rawGender ?? '').trim().toLowerCase();\n\nlet helixGender = null;\n\nif (genderName === 'male' || genderValue === '1') {\n  helixGender = 1;\n} else if (genderName === 'female' || genderValue === '2' || genderValue === '0') {\n  helixGender = 2;\n} else if (\n  genderName === 'other' ||\n  genderName === 'indeterminate' ||\n  genderValue === '3'\n) {\n  helixGender = 3;\n}\n\nreturn [\n  {\n    json: {\n      HelixGender: helixGender,\n    },\n  },\n];"
        },
        "type": "n8n-nodes-base.code",
