      {
        "parameters": {
          "toRecipients": "operations@ashleyandmartin.com.au",
          "subject": "Automation - Helix User Creation",
          "bodyContent": "=Hi Team,\n\nThere is a potential match for the user {{ $('Start').item.json.ClientCode }} from the {{ $('Start').item.json.ClinicName }} in helix.\n\nCode: {{ $('Start').item.json.ClientCode }}\nEmail: {{ $('Start').item.json.HelixEmail }}\n\nCan you please investigate and resolve if required.\n\nRegards,\nAutomation",
