    {
      "parameters": {
        "jsCode": "const item = $json;\nconst error = item.error || {};\n\nlet status = error.status || null;\nlet rawMessage = error.message || '';\nlet helixError = null;\n\n// n8n/Axios often gives: 400 - \"{\\\"Status\\\":400,...}\"\nconst jsonMatch = rawMessage.match(/\\{.*\\}/s);\n\nif (jsonMatch) {\n  try {\n    helixError = JSON.parse(jsonMatch[0].replace(/\\\\\"/g, '\"'));\n  } catch (e) {\n    try {\n      helixError = JSON.parse(jsonMatch[0]);\n    } catch (_) {}\n  }\n}\n\nconst fieldErrors = helixError?.FieldErrors || [];\n\nreturn [\n  {\n    json: {\n      error_status: helixError?.Status || status,\n      error_message: helixError?.Message || rawMessage,\n      field_errors: fieldErrors.map((field) => ({\n        field: field.FieldName,\n        errors: field.Errors || [],\n      })),\n      first_field_error: fieldErrors[0]\n        ? `${fieldErrors[0].FieldName}: ${(fieldErrors[0].Errors || []).join(', ')}`\n        : null,\n    },\n  },\n];"
      },
