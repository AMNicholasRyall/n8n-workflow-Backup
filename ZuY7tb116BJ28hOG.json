          "jsonBody": "={\n  \"FirstName\": \"{{ $('GetGuestInfo').item.json.personal_info.first_name }}\",\n  \"Surname\": \"{{ $('GetGuestInfo').item.json.personal_info.last_name }}\",\n  \"Gender\": {{ $('GenderClean').item.json.HelixGender }},\n  \"DateOfBirth\": \"{{ $('GetGuestInfo').item.json.personal_info.date_of_birth }}\",\n  \"Email\": \"{{ $('Start').item.json.HelixEmail }}\",\n  \"OtherEmail\": \"{{ $('Start').item.json.HelixEmail }}\",\n  \"RefusedToGiveEmail\": false,\n  \"MobilePhoneNumber\": {\n    \"Number\": \"{{ $('GetGuestInfo').item.json.personal_info.mobile_phone.phone_code }}{{ $('GetGuestInfo').item.json.personal_info.mobile_phone.number }}\",\n    \"IsMobile\": true\n  },\n  \"RefusedToGiveMobilePhoneNumber\": false,\n  \"RefusedToGivePrimaryPhoneNumber\": true,\n  \"RefusedToGiveMedicareCard\": true,\n  \"RefusedToGiveConcessionCard\": true,\n  \"RefusedToGiveEmergencyContact\": true,\n  \"IsActive\": true,\n  \"Status\": 2,\n  \"PatientIsClaimant\": true,\n  \"RegularCentre\": {{ $('Start').item.json.HelixCenterID }},\n  \"PatientAddress\": {\n    \"Street1\": \"{{ $('GetGuestInfo').item.json.address_info.address_1 }}\",\n    \"Street2\": \"{{ $('GetGuestInfo').item.json.address_info.address_2 }}\",\n    \"Suburb\": \"{{ $('GetGuestInfo').item.json.address_info.city }}\",\n    \"State\": \"{{ $('Get State').item.json.State_abbreviation }}\",\n    \"Postcode\": \"{{ $('GetGuestInfo').item.json.address_info.zip_code }}\",\n    \"Country\": \"Australia\",\n    \"IsAustralian\": true\n  },\n  \"PostalAddress\": {\n    \"Street1\": \"{{ $('GetGuestInfo').item.json.address_info.address_1 }}\",\n    \"Street2\": \"{{ $('GetGuestInfo').item.json.address_info.address_2 }}\",\n    \"Suburb\": \"{{ $('GetGuestInfo').item.json.address_info.city }}\",\n    \"State\": \"{{ $('Get State').item.json.State_abbreviation }}\",\n    \"Postcode\": \"{{ $('GetGuestInfo').item.json.address_info.zip_code }}\",\n    \"Country\": \"Australia\",\n    \"IsAustralian