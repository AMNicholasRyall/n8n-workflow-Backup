          "specifyBody": "=\n{{ {\n  \"message\": {\n    \"subject\": \"Automation - NoShow - \" +\n      $('Get guest Details').item.json.code,\n\n    \"body\": {\n      \"contentType\": \"HTML\",\n      \"content\":\n        \"<p>Hi Team,</p>\" +\n\n        \"<p>The scheduled telehealth appointment for \" +\n        $('CleanUpHeaders').item.json.body.data.guest.first_name + \" \" +\n        $('CleanUpHeaders').item.json.body.data.guest.last_name +\n        \" was not attended. Please follow up with the patient to reschedule at the earliest convenience and update the booking accordingly.</p>\" +\n\n        \"<p>\" +\n        \"<strong>Name:</strong> \" +\n        $('CleanUpHeaders').item.json.body.data.guest.first_name + \" \" +\n        $('CleanUpHeaders').item.json.body.data.guest.last_name + \"<br>\" +\n\n        \"<strong>Code:</strong> \" +\n        $('Get guest Details').item.json.code + \"<br>\" +\n\n        \"<strong>Profile URL:</strong> \" +\n        \"<a href='https://ashleymartinau.zenoti.com/Guests/GuestProfileV2/GuestProfileV2Wrapper.aspx?Display=True&UserId=\" +\n        $('Get guest Details').item.json.id +\n        \"'>Client Profile</a><br>\" +\n\n        \"<strong>Clinic:</strong> \" +\n        $('Get Home Clinic').item.json.name +\n        \"</p>\" +\n\n        \"<p>Regards,<br>Automation.</p>\"\n    },\n\n    \"toRecipients\": [\n      {\n        \"emailAddress\": {\n          \"address\": $('Get Home Clinic').item.json.email\n        }\n      }\n    ]\n  },\n\n  \"saveToSentItems\": true\n} }}",
